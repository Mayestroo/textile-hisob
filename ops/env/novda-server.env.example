# Copy to /etc/novda/server.env on the dedicated host. Never commit the filled file.
NODE_ENV=production
HOST=0.0.0.0
PORT=3474
NOVDA_PUBLIC_API_URL=https://sync.novdatextile.uz
MIN_CLIENT_VERSION=1.0.0
ALLOW_TEST_TOKENS=false
LOG_LEVEL=info
ENABLE_HEALTH_ENDPOINT=true
NOVDA_BUSINESS_MUTATIONS_ENABLED=false
NOVDA_ADMIN_BOT_INTERNAL_URL=http://novda-admin-bot:8080
NOVDA_ADMIN_WEBAPP_URL=https://sync.novdatextile.uz/admin-app

# Use a secret manager or protected root-readable file for the real value.
# The application role must be non-superuser and the database must require TLS
# when it is not on the same protected host.
DATABASE_URL=postgresql://novda_app:REPLACE_ME@novda-postgres:5432/novda_prod?sslmode=prefer

# Ed25519 private signing stays in novda-admin-bot. This API stores and verifies
# signed activation records using the pinned public key only.

# Production business writes remain closed unless explicitly enabled. When
# enabled, only devices registered by an approved, signed activation request
# pass the authenticated device gate.
