<Configuration>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\NovdaReleaseInputs\Installers</HostFolder>
      <SandboxFolder>C:\Installers</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\NovdaReleaseInputs\LegacyPayload</HostFolder>
      <SandboxFolder>C:\LegacyPayload</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\NovdaReleaseInputs\TestOutput</HostFolder>
      <SandboxFolder>C:\TestOutput</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\NovdaReleaseInputs\Project</HostFolder>
      <SandboxFolder>C:\Project</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -NonInteractive -Command "&amp; { $env:NOVDA_DISPOSABLE_WINDOWS = '1'; Set-Content -LiteralPath 'C:\TestOutput\sandbox-logon-started.txt' -Value 'started'; &amp; 'C:\Project\ops\windows-sandbox\nsis-upgrade-matrix.ps1' -DisposableSandbox *&gt;&amp;1 | Tee-Object -FilePath 'C:\TestOutput\nsis-upgrade-matrix-transcript.txt' }"</Command>
  </LogonCommand>
</Configuration>
