# ==============================================================================
# Novda Hisob-Kitob  — Authoritative Production Server Environment Template
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS INTO VERSION CONTROL.
# Copy this file to .env.production on the production host and fill in values.

# ------------------------------------------------------------------------------
# 1. Database Connection & Credentials (Least-Privilege Dedicated Role)
# ------------------------------------------------------------------------------
# DO NOT USE postgres superuser. Use dedicated novda_app role created via production_roles.sql.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://novda_app:CHANGE_ME_STRONG_PASSWORD@novda-postgres:5432/novda_prod?sslmode=prefer

# ------------------------------------------------------------------------------
# 2. Server Process & Binding
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3474
HOST=0.0.0.0
NOVDA_PUBLIC_API_URL=https://sync.novdatextile.uz

# ------------------------------------------------------------------------------
# 3. Client Version Write Fence
# ------------------------------------------------------------------------------
# Enforces that any client submitting writes has reached at least this version.
MIN_CLIENT_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 4. License Verification Material
# ------------------------------------------------------------------------------
# The novda-admin-bot is the only production service with the Ed25519 private key.
# This API stores signed records and uses public verification material only.

# ------------------------------------------------------------------------------
# 5. Security & Test Overrides
# ------------------------------------------------------------------------------
# In production, this MUST ALWAYS be false (or omitted).
ALLOW_TEST_TOKENS=false

# Business mutation routes fail closed unless explicitly enabled. Production
# compose enables this only after the baseline is verified; authenticated
# writers must also be registered devices from signed activation approval.
NOVDA_BUSINESS_MUTATIONS_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Logging & Health
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_HEALTH_ENDPOINT=true
